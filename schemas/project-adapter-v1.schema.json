{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Project Adapter exchange v1",
  "description": "JSONL request/response frames, replay plans and comparison receipts. Only the driver routes messages between workers and neither worker receives the other's output.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/suite"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "nonempty": {"type": "string", "pattern": "\\S"},
    "identifier": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "status": {"enum": ["TRACE_CONFORMANT", "TRACE_DRIFTED", "TRACE_INCOMPLETE", "STALE", "UNKNOWN"]},
    "observation": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "command": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"$ref": "#/$defs/nonempty"}}
    },
    "mapped_event": {
      "oneOf": [
        {"type": "object", "required": ["event"], "properties": {"event": {"$ref": "#/$defs/nonempty"}, "stutter": false, "unknown": false}},
        {"type": "object", "required": ["stutter"], "additionalProperties": false, "properties": {"stutter": {"$ref": "#/$defs/nonempty"}}},
        {"type": "object", "required": ["unknown"], "additionalProperties": false, "properties": {"unknown": {"$ref": "#/$defs/nonempty"}}}
      ]
    },
    "execution_result": {
      "type": "object",
      "required": ["complete", "events"],
      "properties": {
        "complete": {"type": "boolean"},
        "events": {"type": "array"},
        "state": true,
        "observation": {"$ref": "#/$defs/observation"},
        "stutter": {"$ref": "#/$defs/nonempty"},
        "supported": {"type": "boolean"}
      }
    },
    "request": {
      "type": "object",
      "required": ["id", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "method": {"enum": ["reset", "snapshot", "execute", "abstract_state", "normalize", "observe"]},
        "params": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "reset"}}},
          "then": {"properties": {"params": {"required": ["seed", "environment_profile"], "additionalProperties": false, "properties": {"seed": {"$ref": "#/$defs/seed"}, "environment_profile": {"type": "object"}}}}}
        },
        {
          "if": {"properties": {"method": {"const": "snapshot"}}},
          "then": {"properties": {"params": {"maxProperties": 0}}}
        },
        {
          "if": {"properties": {"method": {"const": "execute"}}},
          "then": {"properties": {"params": {"required": ["command", "test_context"], "additionalProperties": false, "properties": {"command": {"$ref": "#/$defs/command"}, "test_context": {"type": "object"}}}}}
        },
        {
          "if": {"properties": {"method": {"const": "abstract_state"}}},
          "then": {"properties": {"params": {"required": ["snapshot", "mapping_id"], "additionalProperties": false, "properties": {"snapshot": true, "mapping_id": {"$ref": "#/$defs/nonempty"}}}}}
        },
        {
          "if": {"properties": {"method": {"const": "normalize"}}},
          "then": {"properties": {"params": {"required": ["event", "mapping_id"], "additionalProperties": false, "properties": {"event": true, "mapping_id": {"$ref": "#/$defs/nonempty"}}}}}
        },
        {
          "if": {"properties": {"method": {"const": "observe"}}},
          "then": {"properties": {"params": {"required": ["result", "observation_id"], "additionalProperties": false, "properties": {"result": true, "observation_id": {"$ref": "#/$defs/nonempty"}}}}}
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "result": true, "error": {"type": "object"}},
      "oneOf": [{"required": ["result"]}, {"required": ["error"]}]
    },
    "versions": {
      "type": "object",
      "required": ["adapter_version", "mapping_version", "oracle_version", "sut_revision"],
      "additionalProperties": false,
      "properties": {
        "adapter_version": {"$ref": "#/$defs/revision"},
        "mapping_version": {"$ref": "#/$defs/revision"},
        "oracle_version": {"$ref": "#/$defs/revision"},
        "sut_revision": {"$ref": "#/$defs/revision"},
        "sut_mutation_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sut_argv", "oracle_argv", "seed", "environment_profile", "commands", "mapping_id", "observation_id", "versions", "stutters", "test_context", "timeout"],
      "properties": {
        "schema_version": {"const": "project-adapter-suite/v1"},
        "sut_argv": {"$ref": "#/$defs/argv"},
        "oracle_argv": {"$ref": "#/$defs/argv"},
        "seed": {"$ref": "#/$defs/seed"},
        "environment_profile": {"type": "object"},
        "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
        "mapping_id": {"$ref": "#/$defs/nonempty"},
        "observation_id": {"$ref": "#/$defs/nonempty"},
        "versions": {"$ref": "#/$defs/versions"},
        "stutters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonempty"}},
        "evidence": {"type": ["object", "null"], "additionalProperties": {"type": "object"}},
        "test_context": {"type": "object"},
        "sut_cwd": {"type": ["string", "null"]},
        "oracle_cwd": {"type": ["string", "null"]},
        "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 300}
      }
    },
    "receipt": {
      "type": "object",
      "required": ["schema_version", "status", "input", "input_sha256", "runner_sha256", "initial", "steps", "workers", "unknown_steps", "failure"],
      "properties": {
        "schema_version": {"const": "project-adapter-receipt/v1"},
        "status": {"$ref": "#/$defs/status"},
        "input": {"$ref": "#/$defs/suite"},
        "input_sha256": {"$ref": "#/$defs/digest"},
        "runner_sha256": {"$ref": "#/$defs/digest"},
        "initial": {"type": ["object", "null"]},
        "steps": {"type": "array", "items": {"type": "object"}},
        "workers": {"type": "object"},
        "unknown_steps": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "failure": {"type": ["object", "null"]}
      }
    }
  }
}
