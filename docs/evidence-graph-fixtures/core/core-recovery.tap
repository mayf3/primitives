UMAN_REQUIRED，不得改用其他写入口或绕过权限。\\n6. 若提交遇到 workflow_state_version_conflict，重新读取实例后按上述规则再试一次；其他错误不要重复提交或反复重试，也不要自动重试。若重读发现 detail.current_node_visit_id 已变化，不得继续执行旧节点。","messageOrigin":{"kind":"workflow_execution","workflowInstanceId":"4d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e55","nodeVisitId":"0d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e11","attemptId":"wfeat-b05e0a0f82bf83095b98cdf6"}}],"events":[{"kind":"attempt_planned","attemptId":"wfeat-b05e0a0f82bf83095b98cdf6","deliveryProtocol":"write_ahead_v1","nodeVisitId":"0d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e11","dispatchIntentId":"2d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e33","workflowInstanceId":"4d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e55","ownerPrincipalId":"5d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e66","atMs":1795822455503},{"nodeVisitId":"0d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e11","atMs":1795822455518,"kind":"resolution_blocked","code":"http_503","workflowInstanceId":"4d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e55"},{"workflowInstanceId":"4d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e55","nodeVisitId":"0d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e11","dispatchIntentId":"2d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e33","ownerPrincipalId":"5d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e66","expectedAttemptId":"wfeat-b05e0a0f82bf83095b98cdf6","expectedGeneration":1,"requestId":"wfeat-b05e0a0f82bf83095b98cdf6","expectedRecoveryRevision":0,"ruleRef":"accepted:AGENT_CORE_WORKFLOW_RECOVERY_LIVENESS_V1\#CTR-EKRWAE-005","triggerId":"wfeat-b05e0a0f82bf83095b98cdf6:1:1","failures":1,"nextCheckAtMs":1795822455715,"result":"checking","kind":"recovery_checked","atMs":1795822455635},{"nodeVisitId":"0d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e11","atMs":1795822455686,"kind":"resolution_blocked","code":"http_503","workflowInstanceId":"4d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e55"},{"workflowInstanceId":"4d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e55","nodeVisitId":"0d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e11","dispatchIntentId":"2d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e33","ownerPrincipalId":"5d5c2f0a-3f19-4a7e-9a3f-5d1c2b0a9e66","expectedAttemptId":"wfeat-b05e0a0f82bf83095b98cd